{
  "name": "cpatgt-interactives",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "nim",
    "milk"
  ],
  "scripts": {
    "dev:nim": "npm run dev -w nim",
    "dev:milk": "npm run dev -w milk",
    "build": "npm run build --workspaces --if-present",
    "preview:nim": "npm run preview -w nim",
    "preview:milk": "npm run preview -w milk",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
